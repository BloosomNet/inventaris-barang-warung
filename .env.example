# Salin berkas ini menjadi .env, lalu isi dengan pengaturanmu sendiri.
# Jangan pernah mengunggah berkas .env yang sudah diisi ke repositori.
# Port bawaan 3002, biar nggak tabrakan sama kasir (3000) dan katalog (3001)
# kalau ketiganya dijalankan bareng di mesin yang sama.
PORT=3002
DB_HOST=localhost
DB_PORT=3306
DB_USER=inventaris
DB_PASSWORD=
DB_NAME=inventaris_warung
